---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
  title="Contact Us — TED Talk Finder | Get In Touch & Support"
  description="Have questions, talk curation suggestions, or feedback? Get in touch with the TED Talk Finder team. We review speaker requests and inquiries within 24–48 hours."
  canonicalUrl="https://tedtalksfinder.com/contact"
>
  <Header activePage="contact" />

  <main class="flex-grow bg-white py-12 sm:py-20 px-4 sm:px-6 md:px-12">
    <div class="max-w-4xl mx-auto space-y-12">
      <div class="border-b border-gray-200 pb-6 text-center sm:text-left">
        <p class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-[#EB0028] mb-2">
          Get In Touch
        </p>
        <h1 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-black">
          Contact &amp; Support
        </h1>
        <p class="text-sm sm:text-base text-gray-600 mt-3 max-w-2xl">
          Have feedback, channel recommendations, speaker requests, or questions about our AI-powered discovery engine? Reach out to the TED Talk Finder team below.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Contact Information Sidebar -->
        <div class="md:col-span-1 space-y-6">
          <div class="bg-gray-50 border border-gray-200 p-6 space-y-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-black">
              Direct Inquiries
            </h3>
            <ul class="text-xs text-gray-600 space-y-3">
              <li>
                <strong class="text-black block mb-0.5">Talk Recommendations:</strong>
                Suggest iconic or recent talks from official TED / TEDx channels.
              </li>
              <li>
                <strong class="text-black block mb-0.5">Engine Feedback:</strong>
                Report search accuracy, AI summary bugs, or feature ideas.
              </li>
              <li>
                <strong class="text-black block mb-0.5">Response Time:</strong>
                We review submissions within 24–48 business hours.
              </li>
            </ul>
          </div>

          <div class="border border-gray-200 p-6 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-black">
              Disclaimer Note
            </h3>
            <p class="text-xs text-gray-500 leading-relaxed">
              TED Talk Finder is an independent utility. To contact TED Conferences LLC directly, visit <a href="https://www.ted.com/contact" target="_blank" rel="noopener noreferrer" class="text-[#EB0028] hover:underline">ted.com/contact</a>.
            </p>
          </div>
        </div>

        <!-- Contact Form Main -->
        <div class="md:col-span-2">
          <div id="contact-success" class="hidden bg-green-50 border border-green-200 p-6 mb-8 text-center sm:text-left">
            <h3 class="text-green-800 font-bold uppercase text-sm mb-1">Message Sent Successfully!</h3>
            <p class="text-green-700 text-xs sm:text-sm">Thank you for reaching out. We will review your message shortly.</p>
          </div>

          <div id="contact-error" class="hidden bg-red-50 border border-red-200 p-4 mb-6 text-red-700 text-xs sm:text-sm font-semibold">
          </div>

          <form id="contact-form" class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                  Your Name <span class="text-[#EB0028]">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Alex Smith"
                  class="w-full bg-[#F4F4F4] text-black px-4 py-3 border border-gray-300 focus:outline-none focus:border-[#EB0028] text-sm"
                />
              </div>
              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                  Email Address <span class="text-[#EB0028]">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="alex@example.com"
                  class="w-full bg-[#F4F4F4] text-black px-4 py-3 border border-gray-300 focus:outline-none focus:border-[#EB0028] text-sm"
                />
              </div>
            </div>

            <div>
              <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                Subject <span class="text-[#EB0028]">*</span>
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                placeholder="e.g. Talk recommendation or question"
                class="w-full bg-[#F4F4F4] text-black px-4 py-3 border border-gray-300 focus:outline-none focus:border-[#EB0028] text-sm"
              />
            </div>

            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                Message <span class="text-[#EB0028]">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Write your message here..."
                class="w-full bg-[#F4F4F4] text-black px-4 py-3 border border-gray-300 focus:outline-none focus:border-[#EB0028] text-sm resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full sm:w-auto bg-[#EB0028] text-white font-bold uppercase tracking-wider text-xs px-8 py-4 hover:bg-[#c40020] transition-colors cursor-pointer"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const successBox = document.getElementById("contact-success") as HTMLDivElement;
  const errorBox = document.getElementById("contact-error") as HTMLDivElement;

  const BACKEND_URL =
    (import.meta as any).env.PUBLIC_BACKEND_URL || "http://localhost:3001";

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorBox.classList.add("hidden");
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";

      const formData = new FormData(form);
      const payload = {
        name: formData.get("name"),
        email: formData.get("email"),
        subject: formData.get("subject"),
        message: formData.get("message"),
      };

      try {
        const response = await fetch(`${BACKEND_URL}/api/contact`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.error || "Failed to submit message.");
        }

        form.reset();
        form.classList.add("hidden");
        successBox.classList.remove("hidden");
      } catch (err: any) {
        errorBox.textContent = err.message || "An error occurred. Please try again later.";
        errorBox.classList.remove("hidden");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send Message";
      }
    });
  }
</script>
