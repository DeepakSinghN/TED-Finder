{
  "name": "find-ted-talks",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "start": "node server.js",
    "server": "node --watch server.js",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:server\"",
    "ingest": "node scripts/ingest.js",
    "sync:rss": "node scripts/rssSync.js",
    "seed": "node db/seedChannels.js",
    "deploy": "astro build && wrangler pages deploy dist --project-name ted-finder --branch main"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.7",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "wrangler": "^4.103.0"
  }
}
